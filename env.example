# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,grc-service,fcc.tunnel.ictpack.net,*.tunnel.ictpack.net,fims-uat.fcc.ictpack.net

# Database
DB_NAME=fims_grc
DB_USER=grc_user
DB_PASSWORD=grc_password_2024
DB_HOST=postgres-grc-service
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis-grc-service:6379/0
CELERY_BROKER_URL=redis://redis-grc-service:6379/1
CELERY_RESULT_BACKEND=redis://redis-grc-service:6379/2

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=grc-service

# Service URLs
IAM_SERVICE_URL=http://iam-service:8000
DOCUMENT_SERVICE_URL=http://document-records-service:8002
WORK_ORCHESTRATION_SERVICE_URL=http://work-orchestration-service:8004

# Workflow templates are seeded into Work Orchestration Service and resolved
# at runtime by OrchestrationClient._get_template_id_by_code() — no manual
# UUID configuration needed. To seed templates, run inside the WO container:
#   docker exec <wo-container> python manage.py seed_workflow_templates
# To verify resolution, run inside the GRC container:
#   docker exec <grc-container> python manage.py register_workflow_templates --fetch

# Service-to-service authentication
SERVICE_TO_SERVICE_TOKEN=fims-service-secret-token

# Domains
TUNNEL_DOMAIN=fcc.tunnel.ictpack.net
EXTERNAL_DOMAIN=fcc.tunnel.ictpack.net
